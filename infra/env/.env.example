# ---------------------------------------------------------------------------
# XCRM environment variables.
# Copy to .env for each app; Railway sets these per-service in production.
# ---------------------------------------------------------------------------

# Database (shared by ops, portal, worker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xcrm

# Redis (worker + job enqueue from ops)
REDIS_URL=redis://localhost:6379

# Ops auth — NextAuth secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

# Portal — session cookies sign themselves off DB tokens; no JWT secret needed.
# PORTAL_APP_URL is used in magic-link emails (not wired in Phase 0).
PORTAL_APP_URL=http://localhost:3001

# Email (Phase 3)
RESEND_API_KEY=

# Object storage (Phase 2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=xcrm-assets
R2_PUBLIC_URL_BASE=

# LLM (Phase 2)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Drive ingest (Phase 2)
# Base64-encoded service account JSON. Single blob avoids PEM newline escape
# bugs in Railway's env UI. Share target Drive folders with the service
# account's client_email before connecting them in ops.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Cron for the recurring drive-sync fan-out job. Default every 10 minutes.
DRIVE_SYNC_POLL_CRON=*/10 * * * *

# Logging
LOG_LEVEL=info
