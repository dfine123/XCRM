# ---------------------------------------------------------------------------
# XCRM environment variables.
# Copy to .env for each app; Railway sets these per-service in production.
# ---------------------------------------------------------------------------

# Database (shared by ops, portal, worker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xcrm

# Redis — only consumed when the BullMQ worker service is re-enabled
# (see docs/infra/scheduled-jobs.md). At Phase 0 Drive sync runs inline
# inside the ops app and does not need Redis.
REDIS_URL=redis://localhost:6379

# Ops auth — NextAuth secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

# Portal — session cookies sign themselves off DB tokens; no JWT secret needed.
# PORTAL_APP_URL is used in magic-link emails (not wired in Phase 0).
PORTAL_APP_URL=http://localhost:3001

# Email (Phase 3)
RESEND_API_KEY=

# Object storage (Phase 2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=xcrm-assets
R2_PUBLIC_URL_BASE=

# LLM (Phase 2)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Drive ingest (Phase 2)
# Plain service-account JSON, minified to a single line. Accepted formats:
#   1. Plain JSON: {"type":"service_account","client_email":"...",...}   ← canonical
#   2. Base64 of the same JSON                                           ← legacy, still works
# getDriveClient() tries plain first and falls back to base64. On startup,
# ops logs the first 20 chars of client_email so you can confirm the right
# key loaded. Share target Drive folders with that client_email before
# connecting them in ops.
GOOGLE_SERVICE_ACCOUNT_JSON=

# In-process Drive sync scheduler — see docs/infra/scheduled-jobs.md.
# Turn on for exactly ONE ops replica to avoid duplicate runs. Default off.
DRIVE_SYNC_SCHEDULE_ENABLED=false
DRIVE_SYNC_POLL_CRON=*/15 * * * *
# Context-notes expiration cadence. Default every 10 minutes. Runs under
# the same DRIVE_SYNC_SCHEDULE_ENABLED gate — we wanted one knob for
# "is this replica the in-process cron runner?", not two.
CONTEXT_NOTES_EXPIRE_CRON=*/10 * * * *
# Shared secret protecting POST /api/drive/sync/cron. Generate with:
# openssl rand -base64 32
CRON_SECRET=
# Optional — how the instrumentation hook calls back into the ops HTTP API.
# Defaults to http://127.0.0.1:${PORT:-3000}. Override only if needed.
OPS_INTERNAL_URL=

# Logging
LOG_LEVEL=info
